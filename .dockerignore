# --- Secrets: never copy into an image (** = at any depth) ---
**/.env
**/.env.*
!.env.example
**/*firebase-adminsdk*.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/key.properties
**/*credentials*.json
**/*credentials*.txt
**/.neon

# --- Local data / runtime state ---
instance
uploads
backups
database/backups
**/*.db
**/*.sqlite
**/*.sqlite3

# --- Not needed at runtime ---
.git
.gitignore
.github
.venv
venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.coverage
htmlcov
frontend
mobile
tests
.agents
.claude
*.md
!README.md
vercel.json
render.yaml
