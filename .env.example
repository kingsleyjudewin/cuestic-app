# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
DATABASE_URL=sqlite:///department_club.db

# Timezone and Country
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91

# Security and Authentication
TOKEN_EXPIRY_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Scheduler and Reminders
ENABLE_BACKGROUND_SCHEDULER=false
CONFIRMATION_REMINDER_HOURS=24
DEADLINE_REMINDER_HOURS=24

# Firebase Notifications & Cloud Storage
FIREBASE_CREDENTIALS_PATH=app/club-management-cuestic-firebase-adminsdk-fbsvc-a9db9e3515.json
FIREBASE_STORAGE_BUCKET=club-management-cuestic.firebasestorage.app

# Google Drive Cloud Storage Configuration
DEFAULT_MEDIA_STORAGE=google_drive
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-or-url-here

# AI Copilot Configuration (Gemini or Grok / Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GROK_API_KEY=your-grok-or-groq-api-key-here
GROK_MODEL=qwen/qwen3.8-27b

# Initial Seed Administrator (Used only during initial seeding)
ADMIN_USERNAME=clubadmin
ADMIN_EMAIL=admin@club.edu
ADMIN_PASSWORD=AdminPass123!Secure
FOURTH_TEAM_NAME=Logistics
